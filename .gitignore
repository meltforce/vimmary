# OS
.DS_Store
Thumbs.db

# Docker volumes
pgdata/

# Config and secrets
config.yaml
.env

# Tailscale state
tsnet-*/

# Claude Code — session state stays out, project skills are committed.
# .claude/skills/ has to be negated explicitly: it is the only place Claude Code
# looks for project skills, so an ignored one exists on a single machine.
.claude/*
!.claude/skills/
!.claude/project-standards.json
.claude/settings.local.json
.claude/agents/

# Web frontend build artifacts
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# Internal docs
plan.md
internal_docs/

# Generated mirrors of CLAUDE.md and .claude/skills/ for agents that read the
# AGENTS.md convention. Copies of tracked files, so committing them would give
# the same text two homes that drift apart.
AGENTS.md
.agents/
# Design handoff bundles. What ships out of one is web/src/homelab.css and the
# icon script; the bundle itself is a reference and stays out of the repo.
design_handoff*/
*.zip

# Import data
import/
